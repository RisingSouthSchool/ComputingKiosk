__pycache__/
*.pyc

# Escape-room videos stay on the kiosk only; the folder and gallery page are tracked.
escape-rooms/*
!escape-rooms/.gitkeep
!escape-rooms/index.html

# Usage log: stays on the kiosk
usage.db
usage.db-*

# Remembers when this kiosk first saw each item (for NEW banners)
first_seen.json
first_seen.*.tmp
